{
  "name": "@autoeq-workbench/core",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "benchmark": "tsx benchmarks/run.ts",
    "benchmark:v2": "tsx benchmarks/runV2.ts",
    "benchmark:v2:holdout": "tsx benchmarks/runV2.ts --holdout",
    "benchmark:update": "tsx benchmarks/run.ts --write-baseline",
    "research:v2": "tsx benchmarks/research/run.ts",
    "research:v2:quick": "tsx benchmarks/research/run.ts --preset quick",
    "research:v2:full": "tsx benchmarks/research/run.ts --preset full",
    "research:lab": "tsx benchmarks/research/labCli.ts",
    "research:parity-fixture": "tsx benchmarks/research/parityFixture.ts",
    "research:quantization-fixture": "tsx benchmarks/research/quantizationFixture.ts",
    "research:oracle-report": "tsx benchmarks/research/oracleReport.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.0"
  }
}
